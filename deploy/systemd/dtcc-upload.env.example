# Copy to /etc/dtcc-upload/dtcc-upload.env and replace tokens before starting.
DTCC_UPLOAD_STORAGE_ROOT=/var/lib/dtcc-upload/storage
DTCC_UPLOAD_DB_PATH=/var/lib/dtcc-upload/storage/catalog.sqlite3

# Keep this as a single quoted line. Generate tokens with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DTCC_UPLOAD_TOKENS_JSON='[{"token_id":"vasnas-prod","principal_id":"vasnas","token":"replace-upload-token","scopes":["upload","browse"]},{"token_id":"browser-prod","principal_id":"browser","token":"replace-browser-token","scopes":["browse"]}]'

# Optional principal aliases.
# DTCC_UPLOAD_PRINCIPAL_ALIASES_JSON='{"vbassn":"vasnas"}'
